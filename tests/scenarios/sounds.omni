# every sound (from Finger, the default, round to 808): C2, slide (legato) to G2, then a low F1 held; its peak level
wait 100
expect par23 1
peakreset
wav sound0.wav
key 7 down
wait 500
key 14 down
wait 30
key 7 up
wait 600
key 14 up
wait 300
key 0 down
wait 900
key 0 up
wait 700
wavstop
expect peak_db_max -0.5
expect peak_db_min -20
turn PRESET 1
expect par23 2
peakreset
